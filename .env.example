# IndiaWorks local developer environment template
#
# Copy this file to .env and adjust values for your machine.
# NEVER commit a real .env with production or personal credentials.
#
# Required for docker-compose SQL Server:
#   MSSQL_SA_PASSWORD - SQL Server system administrator password.
#     Use a strong password for any environment beyond throwaway local dev.
#
# Example safe local SQL Server connection string (Windows Auth is common on
# developer Windows machines; Docker SQL Server uses SQL Auth with sa):
#
#   ConnectionStrings__IndiaWorksDb=Server=localhost,1433;Database=IndiaWorksDb;User Id=sa;Password=ChangeMe!LocalDev99;TrustServerCertificate=True;
#
# If you run SQL Server in Docker, the container password and the connection
# string password must match.

MSSQL_SA_PASSWORD=ChangeMe!LocalDev99

# Uncomment and set only if your local SQL Server does not use the default port.
# SQLSERVER_PORT=1433
